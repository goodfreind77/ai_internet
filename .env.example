# Copy to .env locally. Never commit .env or real credentials.
# Node.js 24 LTS + pnpm 10.26.1. Railway uses its own injected PORT.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Required: local PostgreSQL or your own Railway PostgreSQL connection.
# This is a placeholder, NOT an existing database credential.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/aiinternet

# Required by pnpm start / pnpm dev. Set your own strong values.
# ADMIN_PASSWORD: at least 12 characters; TOKEN_SECRET: at least 32 characters.
ADMIN_PASSWORD=
TOKEN_SECRET=

# Public frontend URL, baked into the frontend at build time; NEVER put secrets here.
# Local example: http://localhost:3000
# Railway: https://YOUR-SERVICE.up.railway.app or your verified custom domain.
VITE_PUBLIC_SITE_URL=http://localhost:3000

# Outside Replit, use your own Google Cloud Storage bucket and credentials.
# Replit App Storage credentials do NOT transfer to Railway.
OBJECT_STORAGE_BACKEND=gcs
GOOGLE_CLOUD_PROJECT=
# Option A: path to a local service-account JSON file (keep outside Git).
GOOGLE_APPLICATION_CREDENTIALS=
# Option B: service-account JSON in a Railway secret variable; leave blank locally
# if using GOOGLE_APPLICATION_CREDENTIALS / gcloud Application Default Credentials.
GCS_CREDENTIALS_JSON=
# Paths must include bucket name, e.g. /YOUR_BUCKET/public and /YOUR_BUCKET/private.
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# Optional notifications. Leave blank to run without these integrations.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_KAKAO_PF_ID=
SOLAPI_KAKAO_TEMPLATE_ID=
SOLAPI_SENDER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Existing Replit-only / legacy settings (not needed for the portable launcher).
# BASE_PATH: build command assigns each frontend's path automatically.
# SERVE_STATIC: portable launcher sets true to serve all web apps and API together.
# REPL_ID / REPLIT_DOMAINS: supplied by Replit; do NOT copy to Railway.
# DEFAULT_OBJECT_STORAGE_BUCKET_ID: Replit App Storage metadata; not GCS auth.
# SESSION_SECRET: legacy configured secret; current admin auth uses TOKEN_SECRET.
# TIP_COVERS_VERIFIED: used by the manual cover-release maintenance script only.
